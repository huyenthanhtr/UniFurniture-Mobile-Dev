<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Ticket Stub -->
        <LinearLayout
            android:id="@+id/layoutStub"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivStubIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_products"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvStubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_discount"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Right Coupon Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Code & Expiry Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVoucherCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tab_pill_selected"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="UNIFRESH50"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvVoucherExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voucher_expiry"
                    android:textColor="@color/gray_600"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Voucher Title -->
            <TextView
                android:id="@+id/tvVoucherName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voucher_discount_amount"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvVoucherDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/voucher_condition"
                android:textColor="@color/gray_800"
                android:textSize="12sp" />

            <!-- Minimum Condition or Use Button row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvConditionWarning"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/voucher_upsell"
                    android:textColor="@color/discount_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:id="@+id/spacerCondition"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUse"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/btn_use"
                    android:textSize="11sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    style="@style/Widget.UniFurniture.Button.Primary"
                    app:cornerRadius="18dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
