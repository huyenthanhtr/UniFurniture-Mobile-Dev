<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="16dp"
        android:text="@string/str_nav_account"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Guest layout -->
    <LinearLayout
        android:id="@+id/layoutGuest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="48sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_not_logged_in"
            android:textSize="17sp"
            android:textColor="@color/gray_800"
            android:layout_marginTop="12dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginPrompt"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/str_login_or_register"
            android:layout_marginTop="24dp"
            style="@style/Widget.UniFurniture.Button.Primary" />
    </LinearLayout>

    <!-- User layout -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutUser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@color/white"
                android:gravity="center_vertical">
                <View
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@color/primary"
                    android:layout_marginEnd="12dp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvUserPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_600"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/gray_100" />

            <!-- Menu Items -->
            <TextView
                android:id="@+id/itemOrders"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/str_my_orders"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:foreground="?attr/selectableItemBackground" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_200" android:layout_marginHorizontal="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/str_favorite_products"
                android:textSize="15sp"
                android:paddingHorizontal="20dp"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:foreground="?attr/selectableItemBackground" />

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/gray_100" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/str_logout"
                android:layout_margin="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/error"
                android:textColor="@color/error"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
