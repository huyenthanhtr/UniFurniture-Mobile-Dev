<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:padding="16dp"
        android:text="@string/account_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        android:layout_marginEnd="16dp"
                        app:cardBackgroundColor="@color/gray_100">
                        <ImageView
                            android:id="@+id/ivUserAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_account"
                            android:scaleType="centerInside"
                            android:padding="16dp"
                            app:tint="@color/primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/guest_customer"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/gray_600"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvUserPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_upsell"
                            android:textColor="@color/gray_600"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/primary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/edit_profile"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLoginPrompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login"
                        style="@style/Widget.UniFurniture.Button.Primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Menu Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/itemOrders"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/my_orders"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_history"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemAddresses"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/address_book_title"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_shipping"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemMyReviews"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/my_reviews"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_edit"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/change_password"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_account"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemOrderTracking"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/order_tracking"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_shipping"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemWishlist"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/favorites"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_favorite_border"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <RelativeLayout
                        android:id="@+id/itemNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:paddingHorizontal="20dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:text="@string/notification_title"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            app:drawableStartCompat="@drawable/ic_bell"
                            android:drawablePadding="16dp"
                            app:drawableTint="@color/primary" />

                        <View
                            android:id="@+id/viewNotificationBadge"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_notification_badge"
                            android:visibility="gone" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_200"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemVouchers"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/voucher_wallet"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_cart"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/gray_200">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:animateLayoutChanges="true"
                    android:background="#F4F7F4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/itemAbout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/account_about_title"
                            android:textSize="15sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="12dp"
                            android:gravity="center_vertical"
                            android:textColor="@color/black"
                            app:drawableStartCompat="@drawable/ic_home"
                            android:drawablePadding="16dp"
                            app:drawableTint="@color/primary"
                            android:background="?attr/selectableItemBackground" />

                        <ImageView
                            android:id="@+id/btnTogglePolicies"
                            android:layout_width="56dp"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_arrow_drop_down"
                            app:tint="@color/primary"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/account_policy_title" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/white"
                        android:layout_marginHorizontal="20dp" />

                    <!-- Policies Section: Modern Grid Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPolicyChildren"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="#FBFCFA"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/account_policy_title"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="10dp" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:alignmentMode="alignMargins"
                            android:columnOrderPreserved="false">

                            <!-- Sales Policy -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicySales"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_check"
                                        app:tint="#1B4332" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_sales"
                                        android:textColor="#1B4332"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Shipping Policy -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicyShipping"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_shipping"
                                        app:tint="#B8892F" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_shipping"
                                        android:textColor="#5F4A1B"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Warranty Policy -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicyWarranty"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_history"
                                        app:tint="#2D6A4F" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_warranty"
                                        android:textColor="#2D6A4F"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Return Policy -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicyReturn"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_delete"
                                        app:tint="#B85C38" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_return"
                                        android:textColor="#B85C38"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- U-HOMIE -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicyLoyalty"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_favorite_border"
                                        app:tint="#6D5A8D" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_loyalty"
                                        android:textColor="#6D5A8D"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Partner Policy -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPolicyPartner"
                                android:layout_width="0dp"
                                android:layout_height="82dp"
                                android:layout_columnWeight="1"
                                android:layout_gravity="fill"
                                android:layout_margin="3dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="#E1E7DF"
                                app:cardBackgroundColor="#FFFFFF">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:padding="8dp"
                                    android:gravity="center">
                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@drawable/ic_account"
                                        app:tint="#0F766E" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/policy_partner"
                                        android:textColor="#0F766E"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:layout_marginTop="6dp"/>
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </GridLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/white"
                        android:layout_marginHorizontal="20dp" />

                    <TextView
                        android:id="@+id/itemLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/language_label"
                        android:textSize="15sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        app:drawableStartCompat="@drawable/ic_products"
                        android:drawablePadding="16dp"
                        app:drawableTint="@color/primary"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/logout"
                android:layout_margin="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/error"
                android:textColor="@color/error"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
